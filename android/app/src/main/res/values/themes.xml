<?xml version="1.0" encoding="utf-8"?>
<!--
  The XML theme exists only to host the Compose theme. Everything visible is
  painted by Compose; this controls the window before Compose has drawn a frame.

  The AppCompat parent is deliberate: MainActivity is an AppCompatActivity so
  that AppCompatDelegate.setApplicationLocales works below API 33 (hard rule 7).
  Theme.AppCompat.DayNight resolves values-night/ from AppCompatDelegate's night
  mode, NOT from the Compose theme — so the two must be kept in lockstep, which
  MainActivity does. If they disagree, windowBackground resolves light while
  Compose paints dark and cold start flashes white.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SAAT" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/plate</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="colorPrimary">@color/gilt</item>
        <item name="colorError">@color/ruby</item>
    </style>

</resources>
