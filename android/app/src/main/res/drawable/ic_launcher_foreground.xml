<?xml version="1.0" encoding="utf-8"?>
<!--
  Derived from the desktop's saat/resources/icon/saat.svg, not redrawn.

  Two transformations were forced by the platform:

  1. SCALE 0.60x about the centre. Android crops launcher icons to a
     device-chosen mask, guaranteeing only the central 66dp of the 108dp canvas.
     The desktop mark spans 87.5% of its own canvas and its crown sits two units
     from the edge, so at 1:1 the ring, all four markers and the crown are all
     cropped away. At 0.60x — k = (108/256) x 0.60 = 0.253125, x' = (x-128)k+54
     — the case outer edge lands at radius 28.35 and the crown's at 31.89,
     leaving 1.1dp of margin inside the keyline. 0.70x was tried first and
     cannot work: the crown lands at 37.21, outside even the most generous mask,
     and pulling it inward buries it inside the case ring whose own outer edge
     is at 33.07. There is no annulus where a crown can be both inside the mask
     and outside the case.

  2. EVERY ELEMENT REWRITTEN AS <path>. VectorDrawable supports no other shape —
     the source's <circle>, <rect rx> and <line> have no equivalents.

  Geometry check, all radii measured from the centre (54,54):
     case outer edge  28.35   (r 27.338 + half of stroke 2.025)
     markers          26.325
     hands            20.2 reach
     crown outer      31.894  <- the constraint
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Crown. Drawn first so the case ring overlaps its inner end. -->
    <path
        android:fillColor="#C9A227"
        android:pathData="M82.603,51.216 H85.135 A0.759,0.759 0 0 1 85.894,51.975 V56.025 A0.759,0.759 0 0 1 85.135,56.784 H82.603 A0.759,0.759 0 0 1 81.844,56.025 V51.975 A0.759,0.759 0 0 1 82.603,51.216 Z" />

    <!-- Dial face. Same colour as the background layer, so it reads as a hole
         in the gilt line-work rather than a filled disc. Kept so the foreground
         is self-contained where a launcher renders it alone. -->
    <path
        android:fillColor="#1C1B19"
        android:pathData="M26.663,54 a27.338,27.338 0 1,0 54.675,0 a27.338,27.338 0 1,0 -54.675,0 Z" />

    <!-- Case ring. -->
    <path
        android:strokeColor="#C9A227"
        android:strokeWidth="2.025"
        android:pathData="M26.663,54 a27.338,27.338 0 1,0 54.675,0 a27.338,27.338 0 1,0 -54.675,0 Z" />

    <!-- Hour markers: 12, 6, 3, 9. -->
    <path
        android:fillColor="#C9A227"
        android:pathData="M52.988,27.675 H55.013 A0.506,0.506 0 0 1 55.519,28.181 V33.244 A0.506,0.506 0 0 1 55.013,33.75 H52.988 A0.506,0.506 0 0 1 52.481,33.244 V28.181 A0.506,0.506 0 0 1 52.988,27.675 Z" />
    <path
        android:fillColor="#C9A227"
        android:pathData="M52.988,74.25 H55.013 A0.506,0.506 0 0 1 55.519,74.756 V79.819 A0.506,0.506 0 0 1 55.013,80.325 H52.988 A0.506,0.506 0 0 1 52.481,79.819 V74.756 A0.506,0.506 0 0 1 52.988,74.25 Z" />
    <path
        android:fillColor="#C9A227"
        android:pathData="M74.756,52.481 H79.819 A0.506,0.506 0 0 1 80.325,52.988 V55.013 A0.506,0.506 0 0 1 79.819,55.519 H74.756 A0.506,0.506 0 0 1 74.25,55.013 V52.988 A0.506,0.506 0 0 1 74.756,52.481 Z" />
    <path
        android:fillColor="#C9A227"
        android:pathData="M28.181,52.481 H33.244 A0.506,0.506 0 0 1 33.75,52.988 V55.013 A0.506,0.506 0 0 1 33.244,55.519 H28.181 A0.506,0.506 0 0 1 27.675,55.013 V52.988 A0.506,0.506 0 0 1 28.181,52.481 Z" />

    <!-- Hands, reading roughly ten past ten. -->
    <path
        android:strokeColor="#C9A227"
        android:strokeWidth="3.038"
        android:strokeLineCap="round"
        android:pathData="M54,54 L71.466,43.875" />
    <path
        android:strokeColor="#C9A227"
        android:strokeWidth="3.038"
        android:strokeLineCap="round"
        android:pathData="M54,54 L42.609,45.9" />

    <!-- Centre pinion. -->
    <path
        android:fillColor="#C9A227"
        android:pathData="M51.722,54 a2.278,2.278 0 1,0 4.556,0 a2.278,2.278 0 1,0 -4.556,0 Z" />

</vector>
